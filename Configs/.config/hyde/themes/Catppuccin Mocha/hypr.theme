$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf

$GTK_THEME = Rose-Pine
$ICON_THEME = Tela-circle-pink
$COLOR_SCHEME = prefer-dark

exec = gsettings set org.gnome.desktop.interface icon-theme $ICON_THEME
exec = gsettings set org.gnome.desktop.interface gtk-theme $GTK_THEME
exec = gsettings set org.gnome.desktop.interface color-scheme $COLOR_SCHEME

general {
    gaps_in = 5
    gaps_out = 12
    border_size = 2

    # Active border with colorful gradient using your palette
    col.active_border = rgba(ff85b3ff) rgba(c14a7dff) 45degT
    # Inactive border slightly muted but still colorful
    col.inactive_border = rgba(2e2e3acc) rgba(472d3ccc) 45deg

    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(ff85b3ff) rgba(c14a7dff) 45deg
    col.border_inactive = rgba(2e2e3acc) rgba(472d3ccc) 45deg
    col.border_locked_active = rgba(ff85b3ff) rgba(c14a7dff) 45deg
    col.border_locked_inactive = rgba(2e2e3acc) rgba(472d3ccc) 45deg
}

decoration {
    rounding = 6
    shadow:enabled = false
    dim_around = [0.0]

    blur {
        enabled = no
        size = 8
        passes = 3
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
}

# Apply blur specifically for waybar
layerrule = blur,waybar


$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
@define-color bar-bg rgba(26, 26, 31, 0.8);   /* Slightly transparent deep charcoal */

@define-color main-bg #1a1a1f;               /* Dark background */
@define-color main-fg #fceaff;               /* Soft lilac-pink text */

@define-color wb-act-bg #c14a7d;             /* Dusky rose active block */
@define-color wb-act-fg #fceaff;             /* Matching foreground */

@define-color wb-hvr-bg #472d3c;             /* Muted wine for hover */
@define-color wb-hvr-fg #fceaff;             /* Hover foreground */

@define-color accent #ff85b3;                /* Bright sakura pink accent */
@define-color border #2e2e3a;                /* Dark violet-gray for border */


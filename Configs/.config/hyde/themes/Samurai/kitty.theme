$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty## name:     Vagabond 🗡️
## author:   Styled by ChatGPT for starzor
## blurb:    Gritty, sumi-e inspired palette based on Takehiko Inoue’s Vagabond

# === Core Colors ===
foreground              #e5e5e5
background              #0e0e0e

selection_foreground    #0e0e0e
selection_background    #f0e6d2

cursor                  #8b0000
cursor_text_color       #ffffff

url_color               #f0e6d2

# === Borders ===
active_border_color     #8b0000
inactive_border_color   #2e2e2e
bell_border_color       #f0e6d2

# === Titlebar ===
wayland_titlebar_color  system
macos_titlebar_color    system

# === Tabs ===
active_tab_foreground   #ffffff
active_tab_background   #8b0000
inactive_tab_foreground #e5e5e5
inactive_tab_background #1a1a1a
tab_bar_background      #0e0e0e

# === Marks ===
mark1_foreground        #0e0e0e
mark1_background        #8b0000
mark2_foreground        #0e0e0e
mark2_background        #c2b280
mark3_foreground        #0e0e0e
mark3_background        #666666

# === Terminal Colors ===

# black
color0  #0e0e0e
color8  #2e2e2e

# red
color1  #8b0000
color9  #a80000

# green
color2  #6e7f5f
color10 #879a74

# yellow
color3  #f0e6d2
color11 #fff2c2

# blue
color4  #4a6fa5
color12 #7fa7d6

# magenta
color5  #7f4a88
color13 #9c6ba0

# cyan
color6  #5e7c88
color14 #7d9ba6

# white
color7  #e5e5e5
color15 #ffffff

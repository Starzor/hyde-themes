$HOME/.config/rofi/theme.rasi
* {
    font: "Sawarabi Mincho, Noto Serif JP, serif 12";

    main-bg:        #0e0e0ee6;     // ink black, semi-transparent
    main-fg:        #e5e5e5ff;     // faded parchment white
    main-br:        #8b0000ff;     // samurai red (border/active hint)
    main-ex:        #f0e6d2ff;     // old paper tone
    select-bg:      #8b0000cc;     // deep red w/ opacity
    select-fg:      #ffffff;       // crisp white text
    separatorcolor: transparent;
    border-color:   transparent;
}